# 非秘密設定の一覧。実トークンをこのファイルや .env に保存しない。
# mise.local.toml（gitignore済み）の [env] に設定し、秘密は mise + age で暗号化する。
PUBLIC_MCP_URL=https://mcp.example.com/mcp
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience-tag
ALLOWED_EMAILS=you@example.com
PROXY_PORT=47822
OPENSCREEN_MCP_URL=http://127.0.0.1:47821/mcp
# OPENSCREEN_TOKEN は必須。mise + age から実行時の環境変数に注入する。
# OPENSCREEN_TOKEN=
# Tunnelを起動する場合はTUNNEL_TOKENもmise.local.tomlにage暗号文で登録する。
# TUNNEL_TOKEN=
